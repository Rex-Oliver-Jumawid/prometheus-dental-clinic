# Server-only local configuration in ignored .env.local. Never use VITE_* for secrets.
# Copy Supabase's exact pooler endpoints from Project > Connect; replace placeholders.
# Runtime: transaction pooler, port 6543. Node's pg driver uses unnamed statements.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require"
# Migrations only: direct IPv6 (or session pooler :5432 on IPv4-only networks).
DATABASE_URL_UNPOOLED="postgresql://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# For guarded test/fixture commands. NEVER point these at production patient data.
SUPABASE_PROJECT_REF="REPLACE_WITH_DEDICATED_TEST_PROJECT_REF"
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
BETTER_AUTH_URL="http://127.0.0.1:5173"
